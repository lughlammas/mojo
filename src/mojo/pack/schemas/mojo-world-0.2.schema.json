{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://dreamfabrics.invalid/schemas/mojo-world-0.2.schema.json",
 "title": "Dream Fabrics / MOJO — manifesto de mundo v0.2 (world.mjo)",
 "type": "object",
 "required": [
  "format",
  "schema_version",
  "id",
  "title",
  "kind",
  "engine",
  "semantics",
  "audio"
 ],
 "$defs": {
  "ident": {
   "type": "string",
   "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
  },
  "relpath": {
   "type": "string",
   "minLength": 1,
   "maxLength": 200
  }
 },
 "properties": {
  "format": {
   "const": "dream-fabrics/mojo-world"
  },
  "schema_version": {
   "type": "string",
   "pattern": "^0\\.2\\.[0-9]+$"
  },
  "id": {
   "$ref": "#/$defs/ident"
  },
  "title": {
   "type": "string",
   "minLength": 1,
   "maxLength": 200
  },
  "kind": {
   "enum": [
    "text-adventure",
    "rts-grid"
   ]
  },
  "meta": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "canon": {
     "type": "boolean"
    },
    "author": {
     "type": "string"
    },
    "note": {
     "type": "string"
    }
   }
  },
  "engine": {
   "type": "object",
   "required": [
    "profile",
    "min_mojo"
   ],
   "additionalProperties": false,
   "properties": {
    "profile": {
     "enum": [
      "turn-text-v0",
      "tick-grid-v0"
     ]
    },
    "min_mojo": {
     "type": "string",
     "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    }
   }
  },
  "sim": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "tick_hz",
    "seed",
    "max_entities",
    "max_effects_per_tick"
   ],
   "properties": {
    "tick_hz": {
     "type": "integer",
     "minimum": 1,
     "maximum": 30
    },
    "seed": {
     "type": "integer"
    },
    "max_entities": {
     "type": "integer",
     "minimum": 1,
     "maximum": 5000
    },
    "max_effects_per_tick": {
     "type": "integer",
     "minimum": 1,
     "maximum": 100000
    },
    "max_rule_nodes": {
     "type": "integer",
     "minimum": 1,
     "maximum": 256
    },
    "max_wave_radius": {
     "type": "integer",
     "minimum": 1,
     "maximum": 64
    },
    "max_paths_per_tick": {
     "type": "integer",
     "minimum": 1,
     "maximum": 64
    },
    "max_events_per_tick": {
     "type": "integer",
     "minimum": 1,
     "maximum": 20000
    },
    "snapshot_every_ticks": {
     "type": "integer",
     "minimum": 10,
     "maximum": 100000
    }
   }
  },
  "includes": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "resources": {
     "type": "array",
     "maxItems": 64,
     "items": {
      "type": "string",
      "pattern": "^resources/[A-Za-z0-9._-]+\\.json$",
      "maxLength": 200
     }
    },
    "factions": {
     "type": "array",
     "maxItems": 64,
     "items": {
      "type": "string",
      "pattern": "^factions/[A-Za-z0-9._-]+\\.json$",
      "maxLength": 200
     }
    },
    "rules": {
     "type": "array",
     "maxItems": 64,
     "items": {
      "type": "string",
      "pattern": "^rules/[A-Za-z0-9._-]+\\.json$",
      "maxLength": 200
     }
    },
    "scenarios": {
     "type": "array",
     "maxItems": 64,
     "items": {
      "type": "string",
      "pattern": "^scenarios/[A-Za-z0-9._-]+\\.json$",
      "maxLength": 200
     }
    }
   }
  },
  "mods": {
   "type": "array",
   "maxItems": 16,
   "items": {
    "type": "object",
    "required": [
     "id",
     "path"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "$ref": "#/$defs/ident"
     },
     "path": {
      "$ref": "#/$defs/relpath"
     }
    }
   }
  },
  "ui": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "theme": {
     "type": "string",
     "pattern": "^assets/[A-Za-z0-9._-]+\\.json$",
     "maxLength": 200
    },
    "panels": {
     "type": "array",
     "items": {
      "enum": [
       "resources",
       "selection",
       "commands",
       "wave_forecast",
       "log"
      ]
     }
    }
   }
  },
  "modes": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "min_players": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
     },
     "max_players": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
     },
     "friendly_fire": {
      "type": "boolean"
     },
     "shared_victory": {
      "type": "boolean"
     }
    }
   }
  },
  "semantics": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "narration_style": {
     "type": "string",
     "maxLength": 200
    },
    "model_adapter": {
     "type": "string",
     "maxLength": 40
    },
    "generation_constraints": {
     "type": "array",
     "maxItems": 16,
     "items": {
      "type": "string",
      "maxLength": 80
     }
    }
   }
  },
  "audio": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "provider": {
     "enum": [
      "ragnarok",
      "none"
     ]
    },
    "enabled": {
     "type": "boolean"
    },
    "voice_profile": {
     "type": "string",
     "maxLength": 64
    }
   }
  },
  "world": {
   "type": "object",
   "description": "legado v0.1 (kind=text-adventure): validado pelo schema 0.1 do v0.1"
  },
  "rules": {
   "type": "object",
   "description": "legado v0.1 (kind=text-adventure)"
  },
  "default_scenario": {
   "$ref": "#/$defs/ident"
  },
  "resources": {
   "type": "array",
   "description": "legado v0.1 (kind=text-adventure)"
  }
 },
 "additionalProperties": false,
 "allOf": [
  {
   "if": {
    "properties": {
     "kind": {
      "const": "rts-grid"
     }
    }
   },
   "then": {
    "required": [
     "sim",
     "includes"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "kind": {
      "const": "text-adventure"
     }
    }
   },
   "then": {
    "required": [
     "world",
     "rules"
    ]
   }
  }
 ]
}