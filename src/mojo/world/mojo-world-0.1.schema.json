{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dreamfabrics.invalid/schemas/mojo-world-0.1.schema.json",
  "title": "Dream Fabrics / MOJO — mundo .mjo v0.1",
  "description": "Contrato mínimo do arquivo .mjo (JSON UTF-8). Dado, nunca código. Campos marcados 'PROPOSTA' preenchem lacunas do brief e não são canon.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schema_version", "id", "title", "world", "rules", "semantics", "audio"],
  "$defs": {
    "ident": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "flagname": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_:.-]{0,63}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 2000},
    "shorttext": {"type": "string", "minLength": 1, "maxLength": 200},
    "requires": {
      "description": "PROPOSTA: pré-condições simples e declarativas (nunca expressões executáveis).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "flag": {"$ref": "#/$defs/flagname"},
        "item": {"$ref": "#/$defs/ident"}
      }
    },
    "exit": {
      "description": "PROPOSTA: saída de cena estruturada.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "to", "label"],
      "properties": {
        "id": {"$ref": "#/$defs/ident"},
        "to": {"$ref": "#/$defs/ident"},
        "label": {"$ref": "#/$defs/shorttext"},
        "requires": {"$ref": "#/$defs/requires"},
        "blocked_text": {"$ref": "#/$defs/text"}
      }
    },
    "entity": {
      "description": "PROPOSTA: entidade inspecionável. Conteúdo de exemplo, não canon.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description"],
      "properties": {
        "id": {"$ref": "#/$defs/ident"},
        "name": {"$ref": "#/$defs/shorttext"},
        "aliases": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/shorttext"}},
        "description": {"$ref": "#/$defs/text"},
        "inspect_text": {"$ref": "#/$defs/text"},
        "speakable": {"type": "boolean"},
        "speak_reply": {"$ref": "#/$defs/text"}
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "exits"],
      "properties": {
        "id": {"$ref": "#/$defs/ident"},
        "title": {"$ref": "#/$defs/shorttext"},
        "description": {"$ref": "#/$defs/text"},
        "exits": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/exit"}},
        "entities": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/entity"}}
      }
    }
  },
  "properties": {
    "format": {"const": "dream-fabrics/mojo-world"},
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "id": {"$ref": "#/$defs/ident"},
    "title": {"$ref": "#/$defs/shorttext"},
    "meta": {
      "description": "PROPOSTA: metadados. canon=false marca conteúdo de demonstração.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "canon": {"type": "boolean"},
        "author": {"$ref": "#/$defs/shorttext"},
        "note": {"$ref": "#/$defs/text"}
      }
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "starting_scene", "scenes"],
      "properties": {
        "description": {"$ref": "#/$defs/text"},
        "palette": {
          "type": "array", "maxItems": 16,
          "items": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}
        },
        "starting_scene": {"$ref": "#/$defs/ident"},
        "scenes": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/scene"}}
      }
    },
    "resources": {
      "description": "Recursos externos declarados. Caminhos relativos controlados (sem '..', sem absolutos). Não usados pelo núcleo v0.1; apenas validados.",
      "type": "array", "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path"],
        "properties": {
          "id": {"$ref": "#/$defs/ident"},
          "path": {"type": "string", "minLength": 1, "maxLength": 200},
          "kind": {"enum": ["image", "audio", "text", "other"]}
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "player", "allowed_actions"],
      "properties": {
        "system": {"const": "rpg-minimal-v0"},
        "player": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hp", "max_hp", "inventory"],
          "properties": {
            "hp": {"type": "integer", "minimum": 0, "maximum": 100000},
            "max_hp": {"type": "integer", "minimum": 1, "maximum": 100000},
            "inventory": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/ident"}}
          }
        },
        "allowed_actions": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["look", "inspect", "speak", "go"]}
        },
        "allowed_events": {
          "description": "PROPOSTA: eventos que o modelo pode PROPOR (o núcleo ainda valida). Padrão: apenas set_flag.",
          "type": "array", "uniqueItems": true,
          "items": {"enum": ["set_flag", "give_item", "remove_item", "hp_delta", "move"]}
        }
      }
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["narration_style", "model_adapter", "generation_constraints"],
      "properties": {
        "narration_style": {"$ref": "#/$defs/shorttext"},
        "model_adapter": {"enum": ["configurable", "mock", "local", "remote"]},
        "generation_constraints": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/shorttext"}}
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "enabled", "voice_profile"],
      "properties": {
        "provider": {"const": "ragnarok"},
        "enabled": {"type": "boolean"},
        "voice_profile": {"$ref": "#/$defs/ident"}
      }
    }
  }
}
