{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dreamfabrics.invalid/schemas/mojo-part-0.2.schema.json",
  "title": "Dream Fabrics / MOJO — parte modular v0.2 (faction | resources | rules | scenario | theme)",
  "type": "object",
  "required": ["kind"],
  "properties": {"kind": {"enum": ["faction", "resources", "rules", "scenario", "theme"]}},
  "$defs": {
    "ident": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "relpath": {"type": "string", "minLength": 1, "maxLength": 200},
    "expr": {
      "description": "Literal inteiro/bool/texto curto OU objeto com UM operador da whitelist. Aridade/tipos/profundidade/nós são checados pelo compilador (fonte única: tabela OPS).",
      "oneOf": [
        {"type": "integer", "minimum": -1000000000, "maximum": 1000000000},
        {"type": "boolean"},
        {"type": "string", "maxLength": 64},
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "propertyNames": {
            "enum": [
              "abs",
              "add",
              "all",
              "any",
              "count",
              "div",
              "eq",
              "gt",
              "gte",
              "has_tag",
              "lt",
              "lte",
              "max",
              "min",
              "mod",
              "mul",
              "ne",
              "neg",
              "not",
              "rand_below",
              "ref",
              "sub"
            ]
          }
        }
      ]
    },
    "selector": {
      "oneOf": [
        {"enum": ["self", "target"]},
        {
          "type": "object",
          "required": ["entities"],
          "additionalProperties": false,
          "properties": {"entities": {"type": "object"}}
        }
      ]
    },
    "effect": {
      "type": "object",
      "required": ["op"],
      "properties": {
        "op": {
          "enum": [
            "add_resource",
            "damage",
            "eliminate_faction",
            "emit",
            "end",
            "heal",
            "push",
            "schedule",
            "spawn",
            "status",
            "var_add",
            "var_set",
            "wave"
          ]
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "on", "for", "do"],
      "properties": {
        "id": {"$ref": "#/$defs/ident"},
        "on": {
          "oneOf": [
            {
              "type": "object",
              "required": ["every_ticks"],
              "additionalProperties": false,
              "properties": {"every_ticks": {"type": "integer", "minimum": 1, "maximum": 100000}}
            },
            {
              "type": "object",
              "required": ["event"],
              "additionalProperties": false,
              "properties": {"event": {"enum": ["wave_hit_entity", "structure_destroyed", "unit_died"]}}
            }
          ]
        },
        "for": {"enum": ["world", "team", "faction", "entity"]},
        "filter": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "faction": {"$ref": "#/$defs/ident"},
            "tag": {"$ref": "#/$defs/ident"},
            "type": {"$ref": "#/$defs/ident"},
            "state": {"$ref": "#/$defs/ident"}
          }
        },
        "when": {"$ref": "#/$defs/expr"},
        "do": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/effect"}}
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 100000}
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "tags", "hp", "speed_ticks", "cost", "build_ticks", "entropy_resist"],
      "properties": {
        "id": {"$ref": "#/$defs/ident"},
        "name": {"type": "string", "maxLength": 80},
        "tags": {"type": "array", "items": {"$ref": "#/$defs/ident"}, "maxItems": 12},
        "hp": {"type": "integer", "minimum": 1, "maximum": 100000},
        "speed_ticks": {"type": "integer", "minimum": 1, "maximum": 1000},
        "cost": {"$ref": "#/$defs/cost"},
        "build_ticks": {"type": "integer", "minimum": 0, "maximum": 100000},
        "entropy_resist": {"type": "integer", "minimum": 0, "maximum": 100},
        "gather": {
          "type": "object",
          "required": ["resource", "amount", "cooldown_ticks"],
          "additionalProperties": false,
          "properties": {
            "resource": {"$ref": "#/$defs/ident"},
            "amount": {"type": "integer", "minimum": 1},
            "cooldown_ticks": {"type": "integer", "minimum": 1}
          }
        },
        "attack": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["damage", "range", "cooldown_ticks", "damage_kind"],
              "additionalProperties": false,
              "properties": {
                "damage": {"type": "integer", "minimum": 0},
                "range": {"type": "integer", "minimum": 1, "maximum": 12},
                "cooldown_ticks": {"type": "integer", "minimum": 1},
                "damage_kind": {"$ref": "#/$defs/ident"}
              }
            }
          ]
        },
        "abilities": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "cooldown_ticks", "cost", "range", "do"],
            "properties": {
              "id": {"$ref": "#/$defs/ident"},
              "cooldown_ticks": {"type": "integer", "minimum": 1},
              "cost": {"$ref": "#/$defs/cost"},
              "range": {"type": "integer", "minimum": 1, "maximum": 12},
              "do": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {"$ref": "#/$defs/effect"}
              }
            }
          }
        }
      }
    },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "tags", "hp", "size", "cost", "build_ticks"],
      "properties": {
        "id": {"$ref": "#/$defs/ident"},
        "name": {"type": "string", "maxLength": 80},
        "tags": {"type": "array", "items": {"$ref": "#/$defs/ident"}, "maxItems": 12},
        "hp": {"type": "integer", "minimum": 1},
        "size": {"type": "integer", "minimum": 1, "maximum": 4},
        "cost": {"$ref": "#/$defs/cost"},
        "build_ticks": {"type": "integer", "minimum": 0},
        "produces": {"type": "array", "items": {"$ref": "#/$defs/ident"}},
        "provides": {"type": "object", "additionalProperties": {"type": "integer"}},
        "entropy_resist": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "faction"}}, "required": ["kind"]},
      "then": {
        "required": [
          "format",
          "schema_version",
          "kind",
          "id",
          "name",
          "element",
          "traits",
          "start",
          "structures",
          "units"
        ],
        "additionalProperties": false,
        "properties": {
          "format": {"const": "dream-fabrics/mojo-part"},
          "schema_version": {"type": "string", "pattern": "^0\\.2\\.[0-9]+$"},
          "id": {"$ref": "#/$defs/ident"},
          "kind": {"const": "faction"},
          "name": {"type": "string", "maxLength": 80},
          "element": {"$ref": "#/$defs/ident"},
          "traits": {"type": "array", "items": {"$ref": "#/$defs/ident"}, "maxItems": 12},
          "start": {
            "type": "object",
            "required": ["resources", "structures", "units"],
            "additionalProperties": false,
            "properties": {
              "resources": {"$ref": "#/$defs/cost"},
              "structures": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["type", "at"],
                  "additionalProperties": false,
                  "properties": {"type": {"$ref": "#/$defs/ident"}, "at": {"const": "spawn"}}
                }
              },
              "units": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["type", "count"],
                  "additionalProperties": false,
                  "properties": {
                    "type": {"$ref": "#/$defs/ident"},
                    "count": {"type": "integer", "minimum": 1, "maximum": 50}
                  }
                }
              }
            }
          },
          "structures": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {"$ref": "#/$defs/structure"}
          },
          "units": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/unit"}},
          "statuses": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "required": ["id", "ticks", "modifiers"],
              "additionalProperties": false,
              "properties": {
                "id": {"$ref": "#/$defs/ident"},
                "ticks": {"type": "integer", "minimum": 1},
                "modifiers": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "damage_permille": {"type": "integer", "minimum": -1000, "maximum": 1000},
                    "speed_permille": {"type": "integer", "minimum": -1000, "maximum": 1000},
                    "resist_permille": {"type": "integer", "minimum": -1000, "maximum": 1000}
                  }
                }
              }
            }
          },
          "rules": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/rule"}}
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "resources"}}, "required": ["kind"]},
      "then": {
        "required": ["format", "schema_version", "kind", "id", "resources"],
        "additionalProperties": false,
        "properties": {
          "format": {"const": "dream-fabrics/mojo-part"},
          "schema_version": {"type": "string", "pattern": "^0\\.2\\.[0-9]+$"},
          "id": {"$ref": "#/$defs/ident"},
          "kind": {"const": "resources"},
          "resources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "object",
              "required": ["id", "name"],
              "additionalProperties": false,
              "properties": {
                "id": {"$ref": "#/$defs/ident"},
                "name": {"type": "string"},
                "start_cap": {"type": "integer"},
                "gatherable": {"type": "boolean"},
                "derived": {"type": "boolean"}
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "rules"}}, "required": ["kind"]},
      "then": {
        "required": ["format", "schema_version", "kind", "id", "rules"],
        "additionalProperties": false,
        "properties": {
          "format": {"const": "dream-fabrics/mojo-part"},
          "schema_version": {"type": "string", "pattern": "^0\\.2\\.[0-9]+$"},
          "id": {"$ref": "#/$defs/ident"},
          "kind": {"const": "rules"},
          "vars": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["min", "max", "init"],
              "additionalProperties": false,
              "properties": {
                "min": {"type": "integer"},
                "max": {"type": "integer"},
                "init": {"type": "integer"}
              }
            }
          },
          "rng_streams": {
            "type": "array",
            "items": {"$ref": "#/$defs/ident"},
            "uniqueItems": true,
            "maxItems": 16
          },
          "rules": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/rule"}}
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "scenario"}}, "required": ["kind"]},
      "then": {
        "required": [
          "format",
          "schema_version",
          "kind",
          "id",
          "name",
          "mode",
          "seed",
          "params",
          "grid",
          "teams",
          "players"
        ],
        "additionalProperties": false,
        "properties": {
          "format": {"const": "dream-fabrics/mojo-part"},
          "schema_version": {"type": "string", "pattern": "^0\\.2\\.[0-9]+$"},
          "id": {"$ref": "#/$defs/ident"},
          "kind": {"const": "scenario"},
          "name": {"type": "string"},
          "mode": {"$ref": "#/$defs/ident"},
          "seed": {"type": "integer"},
          "params": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [{"type": "integer"}, {"type": "string", "maxLength": 64}, {"type": "boolean"}]
            }
          },
          "grid": {
            "type": "object",
            "required": ["width", "height", "legend", "layout"],
            "additionalProperties": false,
            "properties": {
              "width": {"type": "integer", "minimum": 4, "maximum": 128},
              "height": {"type": "integer", "minimum": 4, "maximum": 128},
              "legend": {"type": "object", "additionalProperties": {"type": "string"}},
              "layout": {"type": "array", "items": {"type": "string"}}
            }
          },
          "teams": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "name"],
              "additionalProperties": false,
              "properties": {"id": {"$ref": "#/$defs/ident"}, "name": {"type": "string"}}
            }
          },
          "players": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["slot", "faction", "team", "spawn", "controller"],
              "properties": {
                "slot": {"$ref": "#/$defs/ident"},
                "faction": {"$ref": "#/$defs/ident"},
                "team": {"$ref": "#/$defs/ident"},
                "spawn": {"type": "string", "maxLength": 8},
                "controller": {"enum": ["human", "idle"]}
              }
            }
          },
          "objectives": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "text"],
              "additionalProperties": false,
              "properties": {"id": {"$ref": "#/$defs/ident"}, "text": {"type": "string"}}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "theme"}}, "required": ["kind"]},
      "then": {
        "required": ["format", "schema_version", "kind", "id", "colors"],
        "additionalProperties": false,
        "properties": {
          "format": {"const": "dream-fabrics/mojo-part"},
          "schema_version": {"type": "string", "pattern": "^0\\.2\\.[0-9]+$"},
          "id": {"$ref": "#/$defs/ident"},
          "kind": {"const": "theme"},
          "colors": {
            "type": "object",
            "additionalProperties": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}
          },
          "cell_px": {"type": "integer", "minimum": 8, "maximum": 64}
        }
      }
    }
  ]
}
